# Copiá este archivo como .env y completalo con los datos de TU cluster.
# El .env nunca se sube a git (está en .gitignore).

# "local" = CORS acepta http://FRONT_URL (sin https)
NODE_ENV=local
PORT=4000
JWT_SECRET=thisIsASecretStringForTheJwt

# MongoDB Atlas: los datos salen de Connect > Drivers en tu cluster
DB_PROTOCOL="mongodb+srv://"
# Ej: micluster.abc123.mongodb.net
DB_HOST=""
# Usuario de base de datos (Security > Database Access), no el de tu cuenta de Atlas
DB_USER=""
DB_PASS=""
# Respetá mayúsculas y minúsculas, tiene que ser igual al nombre en Atlas
DB_NAME=""

FRONT_URL="localhost:3000"

RECAPTCHA_SECRET_KEY=
RECAPTCHA_MASTER_TOKEN=
